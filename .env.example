# Root-level .env for docker-compose.yml. Copy this to ".env" (same
# directory as docker-compose.yml — Compose loads it automatically) and
# fill in real values before running `docker compose up`.
#
# Never commit the real ".env" file. It's already gitignored.

POSTGRES_DB=oceanguardian
POSTGRES_USER=oceanguardian
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-to-a-random-value

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-64-char-random-string

# Explicit origin list for any non-local deployment — never "*" once this
# is reachable outside your own machine.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "true" only for local dev/demo — creates a demo operator account
# with a well-known password. Never set this to true in a real deployment.
SEED_DEMO_DATA=false
