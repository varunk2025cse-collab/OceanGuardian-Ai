# Copy this file to .env and fill in real values before running the API.
# Never commit the real .env (it's gitignored — see .gitignore).
#
# Sections below are marked REQUIRED / OPTIONAL / DEMO-ONLY /
# PRODUCTION-ONLY so it's unambiguous what a real deployment must set vs.
# what only matters for local dev or an explicit demo run.

# ============================== REQUIRED ==================================

# PostgreSQL connection. SQLite (sqlite:///./oceanguardian.db) also works
# for local dev — see README.md — but Postgres is what CI's migration
# check and any real deployment should use.
DATABASE_URL=postgresql+psycopg2://oceanguardian:oceanguardian@localhost:5432/oceanguardian

# JWT signing key — generate a real one with: openssl rand -hex 32
# The placeholder below is deliberately invalid-looking so it's obvious if
# it ever ends up running for real.
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

APP_NAME=OceanGuardian AI MVP
ENVIRONMENT=development

# ============================== OPTIONAL ===================================
# All of these have safe, honest defaults (real weather via a free/keyless
# provider; deterministic AI explanations; simulated notifications) — the
# system is fully functional with nothing below configured. See
# docs/AI_ARCHITECTURE.md / docs/WEATHER_INTELLIGENCE.md / docs/NOTIFICATIONS.md.

# Weather data provider: "open-meteo" (real, free, no API key needed) or
# "simulated" (deterministic synthetic data for offline dev/demo).
WEATHER_PROVIDER=open-meteo

# Safety State Engine thresholds (0-100 score) — defaults are reasonable;
# override only if you have a documented reason to.
# SAFETY_SCORE_MONITOR=21
# SAFETY_SCORE_CAUTION=41
# SAFETY_SCORE_HIGH_RISK=61
# SAFETY_SCORE_CRITICAL=81

# AI explainability — defaults to a deterministic template (always works,
# no external dependency, no cost). Set AI_PROVIDER=anthropic +
# ANTHROPIC_API_KEY to use a real Claude call for natural-language safety
# explanations; falls back to the template automatically if the call
# fails or the key is unset. UNVERIFIED in this codebase's own test suite
# — no key was available during development (docs/AI_ARCHITECTURE.md).
AI_PROVIDER=template
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Notifications — defaults to "simulation" (logs + records delivery status
# in the database, never claims a real SMS/push/email was sent). Set to
# "twilio" + the TWILIO_* variables below to send real SMS. UNVERIFIED in
# this codebase's own test suite — no credentials were available during
# development (docs/NOTIFICATIONS.md).
NOTIFICATION_PROVIDER=simulation
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=

# Rate limiting (requests/minute per IP) on /auth/login and /auth/register
# only — SOS trigger is deliberately never rate-limited (see
# app/core/rate_limit.py).
RATE_LIMIT_PER_MINUTE=30

# ============================== DEMO-ONLY ===================================
# Never set either of these in a real deployment. See docs/DEMO.md and
# docs/SECURITY.md. scripts/demo_mode.{sh,ps1} set both automatically for
# an isolated demo run and never write them into a persisted .env.

# Creates a demo operator account (+911234567890 / rescue123) when
# seed.py runs. Defaults to false — a real deployment must never enable this.
SEED_DEMO_DATA=false

# Surfaced via GET /api/v1/system-info so the mobile app and rescue
# dashboard render a persistent "DEMO / SIMULATION MODE" banner. Defaults
# to false.
DEMO_MODE=false

# ============================ PRODUCTION-ONLY ===============================
# Only relevant for a real, non-local deployment.

# Explicit comma-separated origin list (e.g.
# https://dashboard.oceanguardian.example). "*" is fine for local dev
# only — a wildcard origin combined with allow_credentials=True is a real
# security smell, not just unsafe in theory (see docs/SECURITY.md).
CORS_ORIGINS=*
